# Copy to .env (or set in your systemd unit / shell) before exposing publicly.
PORT=7531
HOST=127.0.0.1

# Login credentials (REQUIRED for any non-localhost deployment)
CWT_USER=changeme
CWT_PASS=use-a-long-random-password

# Optional: explicit cookie signing key. If unset it is derived from CWT_PASS,
# so logins survive restarts without extra config. Set it to rotate sessions.
# CWT_SECRET=$(openssl rand -hex 32)

# Cookie lifetime in days (default 30)
# CWT_TTL_DAYS=30

# Optional TOTP 2FA. Set a base32 secret to require a 6-digit authenticator
# code at login. Generate one + an otpauth:// URI for your app with:
#   node -e 'const c=require("crypto"),A="ABCDEFGHIJKLMNOPQRSTUVWXYZ234567";let b=c.randomBytes(20),v=0,n=0,s="";for(const x of b){v=(v<<8)|x;n+=8;while(n>=5){s+=A[(v>>>(n-5))&31];n-=5}}if(n>0)s+=A[(v<<(5-n))&31];console.log(s)'
# CWT_TOTP_SECRET=

# Brute-force lockout (per source IP)
# CWT_MAX_FAILS=6            # failures before lockout
# CWT_LOCK_WINDOW_MS=900000  # lockout window (15 min)

# Where session metadata, remembered dirs, and the login audit log (auth.log) live
# CWT_STATE_DIR=~/.config/claude-web-terminal

# --- Running Claude Code from a region that can't reach the API directly ---
# Claude Code needs to reach api.anthropic.com. On a network behind a firewall,
# point it at an HTTPS proxy; this is inherited by every terminal you open:
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
